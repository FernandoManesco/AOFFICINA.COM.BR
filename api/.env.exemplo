# Copie para .env e preencha. O serviço NÃO sobe sem estas variáveis.
# Instância: uma por oficina cliente (banco próprio).
INSTANCIA=manesco_demo
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aofficina
DB_USER=aofficina
DB_PASSWORD=
SECRET_KEY=
JWT_EXPIRA_MIN=600
CORS_ORIGINS=https://app.aofficina.com.br
AMBIENTE=producao
FIPE_TOKEN=
# Assistente de IA (corrigir textos, pesquisar problema e código de peça) — sem a chave as rotas /ia devolvem 503
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
CONTEXTO_IA_MD=contexto_oficina.md
# Escrita à mão no tablet (MyScript iink — mesmas chaves do WebTriagem/Matematicando); opcional
MYSCRIPT_APP_KEY=
MYSCRIPT_HMAC_KEY=
MYSCRIPT_LANG=pt_BR
# Ditado transcrito no servidor (faster-whisper); opcional — requirements-ia.txt
WHISPER_MODELO=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_THREADS=4
WHISPER_CACHE=/home/deploy/modelos/whisper
